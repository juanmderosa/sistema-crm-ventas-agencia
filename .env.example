# Copy to .env.local and set these from your local Supabase instance.
# Public configuration is not a privileged credential.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy local anon keys are also accepted here. Never use a service-role key.
# Never prefix privileged keys with NEXT_PUBLIC_.
# Cloudflare production secrets are configured outside this repository.
